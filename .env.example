# Server
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=residencial
DB_PASSWORD=residencial
DB_NAME=residencial_pass
# Para conexiones remotas (Railway, etc.) poner true
DB_SSL=false

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=1h

# Recovery link (base URL for reset link sent by WhatsApp/SMS)
RECOVERY_LINK_BASE_URL=https://yourapp.com/reset

# Si true, omite validación de deviceId para todos (para review de Google Play).
# SKIP_DEVICE_CHECK=true

# Optional: SMS/WhatsApp providers (for production)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# WHATSAPP_API_URL=
